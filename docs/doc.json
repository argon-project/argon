// argon-config-version: 1
{
    version: "1",
    targets: [
        {
            name: "headers",
            files: [ "/Users/carl/Code/riot-sandbox/RIOT-darwin/RIOT/boards/**/*.h" ],
            language: "c",
            dialect: "doxygen",
            // Local Doxygen settings just apply to this target
            // Global Doxygen settings also apply
            doxygenSettings: {
                decayArrays: true,
                transformFunctionPointers: true,
                directives: []
            }
        },
        {
            name: "docmds",
            files: [ "./**/doc.md", "./**/*.doc.md" ],
            dialect: "doxygen"
        }
    ],
    products: [
        {
            name: "argon-html-preview",
            format: "html",
            targets: [ "headers", "docmd" ],
            htmlSettings: {
                path: ".build/doc/html",
                template: "doc/html/template.html",
            }
        }
    ],
    // Typed entries in addition to articles, groups, and all of the language symbols
    roles: [
        { id: "riot-module",  label: "RIOT Module" },
        { id: "riot-board",   label: "Board" },
        { id: "riot-cpu",     label: "CPU" },
        { id: "riot-example", label: "Example Application" }
    ],
    // Custom metadata per entry
    properties: [
        {
            id: "module-id",
            label: "Module ID",
        },
        {
            id: "board-id",
            label: "Board ID",
        },
        {
            id: "cpu-id",
            label: "CPU ID",
        },
        {
            id: "availability",
            label: "Availability",
        },
        {
            id: "last-riot-version",
            label: "Maintained until",
        },
    ],
    doxygen: {
        // Global Doxygen settings
        doxygenSettings: {
            commands: [
                {
                    name: "deprecated",
                    parameters: [ "release" ],
                    actions: {
                        block: {
                            type: "warning",
                            content: "Deprecated since RIOT $release"
                        },
                        properties: {
                            "availability": "deprecated",
                            "last-riot-version": "$release"
                        },
                    }
                },
                {
                    name: "usemodule",
                    parameters: [ "id" ],
                    actions: {
                        role: "riot-module",
                        properties: {
                            "module-id": "$id"
                        }
                    }
                },
                {
                    name: "board",
                    parameters: [ "id" ],
                    actions: {
                        role: "riot-board",
                        properties: {
                            "board-id": "$id"
                        }
                    }
                },
                {
                    name: "cpu",
                    parameters: [ "id" ],
                    actions: {
                        role: "riot-cpu",
                        properties: {
                            "cpu-id": "$id"
                        }
                    }
                }
            ]
        }
    }
}
